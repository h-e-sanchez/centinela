	partition issues = m
		mode: import
		source =
				let
				    Origen = LeerCsv("issues.csv", {{"issue", type text}, {"industria", type text}, {"proyecto", type text}, {"equipo", type text}, {"tipo", type text}, {"epica_padre", type text}, {"puntos", Int64.Type}, {"creado", type date}, {"fecha_inicio", type date}, {"fecha_fin", type date}, {"estado_al_corte", type text}, {"dias_ciclo", Int64.Type}, {"horas_bloqueado", Int64.Type}, {"sprint", type text}}),
				    Nombre = Table.AddColumn(Origen, "estado_al_corte_nombre", each Record.FieldOrDefault([por_hacer = "Por hacer", en_curso = "En curso", en_revision = "En revisión", bloqueado = "Bloqueado", hecho = "Hecho"], [estado_al_corte], [estado_al_corte]), type text),
				    Orden = Table.AddColumn(Nombre, "estado_al_corte_orden", each Record.FieldOrDefault([por_hacer = 1, en_curso = 2, en_revision = 3, bloqueado = 4, hecho = 5], [estado_al_corte], 9), Int64.Type)
				in
				    Orden

	annotation PBI_ResultType = Table
