		annotation SummarizationSetBy = Automatic

	column fecha
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: 71bf01c0-aeba-5bc2-9260-92cf0d492d23
		summarizeBy: none
		sourceColumn: fecha

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition cobertura = m
		mode: import
		source =
				let
				    Origen = LeerCsv("cobertura_mensual.csv", {{"anio", Int64.Type}, {"mes", Int64.Type}, {"clinica", type text}, {"unidad", type text}, {"estamento", type text}, {"horas_ausencia", type number}, {"horas_requeridas", type number}, {"horas_sobretiempo", type number}, {"horas_pool", type number}, {"horas_externo", type number}, {"horas_no_cubiertas", type number}, {"costo_sobretiempo", type number}, {"costo_pool", type number}, {"costo_externo", type number}}),
				    ConFecha = Table.AddColumn(Origen, "fecha", each #date([anio], [mes], 1), type date)
				in
				    ConFecha

	annotation PBI_ResultType = Table
