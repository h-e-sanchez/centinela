/// Pronóstico 2027 por clínica, unidad, estamento y mes: credibilidad y simulación de episodios.
table pronostico
	lineageTag: a5a521d9-6729-5bc6-a9fa-5b5490f53638

	/// Días perdidos esperados en 2027 con la tasa ajustada por credibilidad y la dotación actual.
	measure 'Días esperados' = SUM(pronostico[dias_esperados])
		formatString: #,##0
		displayFolder: 5. Pronóstico
		lineageTag: 1d4b320a-e9ed-5c05-bcae-64b21b68272d

	/// Borde alto de la banda: las varianzas de la simulación se suman (celdas independientes); los percentiles no.
	measure 'Días P90 (banda)' =
			VAR e = [Días esperados]
			RETURN IF(NOT ISBLANK(e), e + 1.2816 * SQRT(SUM(pronostico[varianza_dias])))
		formatString: #,##0
		displayFolder: 5. Pronóstico
		lineageTag: 51aaa6d3-7af5-5db8-84c1-2d41f2c3bb3d

	/// Borde bajo de la banda, con el mismo criterio.
	measure 'Días P10 (banda)' =
			VAR e = [Días esperados]
			RETURN IF(NOT ISBLANK(e), MAX(0, e - 1.2816 * SQRT(SUM(pronostico[varianza_dias]))))
		formatString: #,##0
		displayFolder: 5. Pronóstico
		lineageTag: 8df0e307-4785-542f-ba3b-b9a60d2eff1f

	/// Tasa propia de cada celda en los dos años de historia.
	measure 'Tasa observada 2025-2026 %' = DIVIDE(SUMX(pronostico, pronostico[tasa_observada] * pronostico[dotacion] * pronostico[dias_habiles]), SUMX(pronostico, pronostico[dotacion] * pronostico[dias_habiles]))
		formatString: 0.0%
		displayFolder: 5. Pronóstico
		lineageTag: 41bc2bb6-7e84-5155-9008-f05ce42f4d79

	/// Z × tasa propia + (1 − Z) × tasa del estamento en la red (Bühlmann-Straub).
	measure 'Tasa con credibilidad %' = DIVIDE(SUMX(pronostico, pronostico[tasa_credibilidad] * pronostico[dotacion] * pronostico[dias_habiles]), SUMX(pronostico, pronostico[dotacion] * pronostico[dias_habiles]))
		formatString: 0.0%
		displayFolder: 5. Pronóstico
		lineageTag: 4da6b514-e282-5532-ba79-8ae5cbd8cfc0

	/// Peso de la historia propia: cerca de 1 con mucha exposición, cerca de 0 con poca.
	measure 'Z credibilidad' = DIVIDE(SUMX(pronostico, pronostico[z_credibilidad] * pronostico[anios_persona]), SUM(pronostico[anios_persona]))
		formatString: 0.00
		displayFolder: 5. Pronóstico
		lineageTag: 52f1ef0d-ad53-50c5-86c7-d087f3566fe5

	/// Exposición de la celda en 2025-2026: la base de la credibilidad.
	measure 'Años-persona' = AVERAGEX(VALUES(pronostico[mes]), CALCULATE(SUM(pronostico[anios_persona])))
		formatString: #,##0.0
		displayFolder: 5. Pronóstico
		lineageTag: 6e0bc9c7-45fe-5c65-b563-e7f977d82863

