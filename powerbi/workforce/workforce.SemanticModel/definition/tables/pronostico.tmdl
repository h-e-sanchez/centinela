	partition pronostico = m
		mode: import
		source =
				let
				    Origen = LeerCsv("pronostico.csv", {{"anio", Int64.Type}, {"mes", Int64.Type}, {"clinica", type text}, {"unidad", type text}, {"estamento", type text}, {"dotacion", Int64.Type}, {"dias_habiles", Int64.Type}, {"tasa_observada", type number}, {"anios_persona", type number}, {"z_credibilidad", type number}, {"tasa_credibilidad", type number}, {"dias_esperados", type number}, {"dias_p50", Int64.Type}, {"dias_p90", Int64.Type}, {"varianza_dias", type number}}),
				    ConFecha = Table.AddColumn(Origen, "fecha", each #date([anio], [mes], 1), type date)
				in
				    ConFecha

	annotation PBI_ResultType = Table
