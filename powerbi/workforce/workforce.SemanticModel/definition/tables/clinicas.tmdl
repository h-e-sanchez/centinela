/// Dimensión: las tres clínicas de la red ficticia.
table clinicas
	lineageTag: f524693e-5599-562c-afd2-95abbf7ccd1c

	column clinica
		dataType: string
		lineageTag: f811577b-0b99-531c-bc0c-de9471104d71
		summarizeBy: none
		sourceColumn: clinica
		sortByColumn: orden

		annotation SummarizationSetBy = Automatic

	column orden
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 3f9bef9e-e069-5ef8-a814-dc1c9530fa92
		summarizeBy: none
		sourceColumn: orden

		annotation SummarizationSetBy = Automatic

	column dotacion_inicial
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 255330ec-5ec2-5b29-9131-587213e955da
		summarizeBy: none
		sourceColumn: dotacion_inicial

		annotation SummarizationSetBy = Automatic

	partition clinicas = m
		mode: import
		source =
				let
				    Origen = LeerCsv("clinicas.csv", {{"clinica", type text}, {"orden", Int64.Type}, {"dotacion_inicial", Int64.Type}})
				in
				    Origen

	annotation PBI_ResultType = Table

