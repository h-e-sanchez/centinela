/// Dimensión de fechas 2025-2026.
table Calendario
	lineageTag: 00d63d91-ec52-5244-9104-6c4b8ac0a211
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: 827efeab-ad98-5661-a09b-5dca838103e0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Anio
		dataType: int64
		formatString: 0
		lineageTag: eb860e78-ef7a-51f6-bef3-b530b036dd2c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Anio]

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b169c1a5-dba2-5851-847c-c19f15f680e4
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes]

		annotation SummarizationSetBy = Automatic

	column 'Nombre Mes'
		dataType: string
		lineageTag: fce3fd08-58c8-5eb1-adc6-0e55b0aff6b3
		summarizeBy: none
		isNameInferred
		sourceColumn: [Nombre Mes]
		sortByColumn: Mes

		annotation SummarizationSetBy = Automatic

	column 'Periodo Num'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5ef0c623-eb4f-56f0-866d-0b5149494b03
		summarizeBy: none
		isNameInferred
		sourceColumn: [Periodo Num]

		annotation SummarizationSetBy = Automatic

	column 'Mes Año'
		dataType: string
		lineageTag: acc457ad-40c3-588d-a9e0-36a478f8db84
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes Año]
		sortByColumn: 'Periodo Num'

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2025, 1, 1), DATE(2026, 12, 31)),
				    "Anio", YEAR([Date]),
				    "Mes", MONTH([Date]),
				    "Nombre Mes", FORMAT([Date], "mmm"),
				    "Periodo Num", YEAR([Date]) * 100 + MONTH([Date]),
				    "Mes Año", FORMAT([Date], "mmm yyyy")
				)

	annotation PBI_ResultType = Table

