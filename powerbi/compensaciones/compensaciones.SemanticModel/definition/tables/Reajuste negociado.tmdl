/// Parámetro what-if: reajuste general negociado (por ejemplo, en una negociación colectiva), de 0% a 10%.
table 'Reajuste negociado'
	lineageTag: b5ce6aea-a877-5aba-8f67-c8f5162ce94d

	/// Reajuste elegido en el segmentador; si no hay uno elegido, 4,5% (el IPC de 2026 en el modelo).
	measure 'Reajuste negociado %' = SELECTEDVALUE('Reajuste negociado'[Reajuste negociado], 0.045)
		formatString: 0.0%
