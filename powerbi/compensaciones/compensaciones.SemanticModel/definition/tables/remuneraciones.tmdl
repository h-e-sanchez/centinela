		sourceColumn: servicio

		annotation SummarizationSetBy = Automatic

	column grado
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5870fc49-31bc-5efc-882a-a9e871eef211
		summarizeBy: none
		sourceColumn: grado

		annotation SummarizationSetBy = Automatic

	column banda
		dataType: string
		isHidden
		lineageTag: 24aa0dd8-4fa1-5dee-8256-68ae1ecd4c89
		summarizeBy: none
		sourceColumn: banda

		annotation SummarizationSetBy = Automatic

	column jornada_horas
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6dbb10c1-45cb-5398-875d-4fcb660504d7
		summarizeBy: none
		sourceColumn: jornada_horas

		annotation SummarizationSetBy = Automatic

	column sueldo_base
		dataType: int64
		isHidden
		formatString: \$ #,##0
		lineageTag: 4e01c10a-c49f-5a71-9fc0-74cf7016bec1
		summarizeBy: none
		sourceColumn: sueldo_base

		annotation SummarizationSetBy = Automatic

	column sueldo_base_44h
		dataType: int64
		isHidden
		formatString: \$ #,##0
		lineageTag: 669c5632-29e7-5da1-8fd2-89ff8640f47e
		summarizeBy: none
		sourceColumn: sueldo_base_44h

		annotation SummarizationSetBy = Automatic

	column variable
		dataType: int64
		isHidden
		formatString: \$ #,##0
		lineageTag: e87031f6-9767-56d4-8bbc-50720e902ea2
		summarizeBy: none
		sourceColumn: variable

		annotation SummarizationSetBy = Automatic

	partition remuneraciones = m
		mode: import
		source =
				let
