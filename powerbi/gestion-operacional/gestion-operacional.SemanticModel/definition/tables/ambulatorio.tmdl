/// Ambulatorio por clínica, especialidad y mes: horas de box, agenda, consultas, inasistencias y lista de espera.
table ambulatorio
	lineageTag: 9fa9f092-bd8f-5928-be47-11d4fdaf735f

	/// Horas de box disponibles (boxes × horario de atención).
	measure 'Horas de box' = SUM(ambulatorio[horas_box])
		formatString: #,##0
		displayFolder: 4. Ambulatorio
		lineageTag: 47aa6b9d-2fdb-5b72-959e-b85b8a26a238

	/// Horas de agenda médica abiertas.
	measure 'Horas ofertadas' = SUM(ambulatorio[horas_ofertadas])
		formatString: #,##0
		displayFolder: 4. Ambulatorio
		lineageTag: 5ce60189-7633-505f-80e3-7d36d1d0a8ee

	/// Horas de agenda abiertas sobre horas de box disponibles.
	measure 'Utilización de box %' = DIVIDE([Horas ofertadas], [Horas de box])
		formatString: 0.0%
		displayFolder: 4. Ambulatorio
		lineageTag: 14b85ef8-1b05-5291-960e-a7d4c4f76eb8

	/// Horas con paciente agendado sobre horas ofertadas.
	measure 'Ocupación de agenda %' = DIVIDE(SUM(ambulatorio[horas_agendadas]), [Horas ofertadas])
		formatString: 0.0%
		displayFolder: 4. Ambulatorio
		lineageTag: cf47014a-8d29-5fe1-908e-2c8c6a86463d

	/// Horas tomadas por pacientes.
	measure 'Consultas agendadas' = SUM(ambulatorio[consultas_agendadas])
		formatString: #,##0
		displayFolder: 4. Ambulatorio
		lineageTag: 9788948e-2047-5bde-917f-04a41c52c207

	/// Consultas agendadas a las que el paciente llegó.
	measure 'Consultas realizadas' = SUM(ambulatorio[consultas_realizadas])
		formatString: #,##0
		displayFolder: 4. Ambulatorio
		lineageTag: 25a29bc6-8807-50f4-a766-702645df5a80

	/// Pacientes agendados que no llegan (no-show).
	measure 'Inasistencia %' = DIVIDE(SUM(ambulatorio[inasistencias]), [Consultas agendadas])
		formatString: 0.0%
		displayFolder: 4. Ambulatorio
		lineageTag: 2b180fc0-76a0-5798-b202-92e85a28981c

	/// Pacientes esperando hora al cierre del último mes del periodo.
	measure 'Lista de espera (último mes)' =
			VAR ultimo = MAX(ambulatorio[fecha])
			RETURN CALCULATE(SUM(ambulatorio[lista_espera]), ambulatorio[fecha] = ultimo)
		formatString: #,##0
		displayFolder: 4. Ambulatorio
		lineageTag: 62af00ed-c5a1-5172-9c8f-9be0a80ea48a

	/// Días hasta la tercera hora disponible en el último mes: mide el acceso sin el ruido de las anulaciones.
	measure 'Días al tercer cupo' =
			VAR ultimo = MAX(ambulatorio[fecha])
			RETURN CALCULATE(AVERAGE(ambulatorio[dias_tercer_cupo]), ambulatorio[fecha] = ultimo)
		formatString: 0
		displayFolder: 4. Ambulatorio
		lineageTag: 6ff791cb-bbb6-5ca8-8ab1-f72ccbde14ec

	column fecha
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: 228e276a-6f37-543c-928a-a21acd111c1f
