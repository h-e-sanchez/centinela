				let
				    Origen = LeerCsv("ambulatorio.csv", {{"fecha", type date}, {"anio", Int64.Type}, {"mes", Int64.Type}, {"sucursal", type text}, {"especialidad", type text}, {"horas_box", Int64.Type}, {"horas_ofertadas", Int64.Type}, {"horas_agendadas", Int64.Type}, {"consultas_agendadas", Int64.Type}, {"consultas_realizadas", Int64.Type}, {"inasistencias", Int64.Type}, {"lista_espera", Int64.Type}, {"dias_tercer_cupo", Int64.Type}})
				in
