	partition pabellones = m
		mode: import
		source =
				let
				    Origen = LeerCsv("pabellones.csv", {{"fecha", type date}, {"anio", Int64.Type}, {"mes", Int64.Type}, {"sucursal", type text}, {"especialidad", type text}, {"horas_habilitadas", Int64.Type}, {"horas_programadas", Int64.Type}, {"horas_utilizadas", Int64.Type}, {"cirugias_programadas", Int64.Type}, {"cirugias_realizadas", Int64.Type}, {"cirugias_suspendidas", Int64.Type}, {"primeras_del_dia", Int64.Type}, {"primeras_a_la_hora", Int64.Type}})
				in
