/// Pabellones por clínica, especialidad y mes: horas habilitadas, programadas y utilizadas, cirugías y puntualidad.
table pabellones
	lineageTag: 2f3a7d63-2f6c-5622-b274-aca6138d3619

	/// Horas de pabellón disponibles (pabellones × horas por día hábil).
	measure 'Horas habilitadas' = SUM(pabellones[horas_habilitadas])
		formatString: #,##0
		displayFolder: 2. Pabellones
		lineageTag: 0471dfc9-4bef-5c3b-9e3b-b712d515d562

	/// Horas de pabellón con paciente, incluido el recambio.
	measure 'Horas utilizadas' = SUM(pabellones[horas_utilizadas])
		formatString: #,##0
		displayFolder: 2. Pabellones
		lineageTag: b411199a-6c56-5dee-809f-4e79495710e1

	/// Horas habilitadas que no se usaron.
	measure 'Horas ociosas' = [Horas habilitadas] - [Horas utilizadas]
		formatString: #,##0
		displayFolder: 2. Pabellones
		lineageTag: 9934ee27-6a1b-5d5d-9107-502a08c224da

	/// Horas utilizadas sobre habilitadas.
	measure 'Utilización de pabellón %' = DIVIDE([Horas utilizadas], [Horas habilitadas])
		formatString: 0.0%
		displayFolder: 2. Pabellones
		lineageTag: c6e441b1-fbc7-5af2-8af7-187ab96404df

	/// Cirugías en la tabla quirúrgica.
	measure 'Cirugías programadas' = SUM(pabellones[cirugias_programadas])
		formatString: #,##0
		displayFolder: 2. Pabellones
		lineageTag: 1c1d88ac-0290-593e-a143-356498fe793a

	/// Cirugías programadas que se hicieron.
	measure 'Cirugías realizadas' = SUM(pabellones[cirugias_realizadas])
		formatString: #,##0
		displayFolder: 2. Pabellones
		lineageTag: f7575ed4-7bb9-5ac2-a673-c7d9837486c5

	/// Cirugías programadas que no se hicieron el día previsto.
	measure 'Cirugías suspendidas' = SUM(pabellones[cirugias_suspendidas])
		formatString: #,##0
		displayFolder: 2. Pabellones
		lineageTag: 94ef3831-2884-578c-9739-26d67be45b38

	/// Cirugías suspendidas sobre programadas.
	measure 'Suspensión de cirugías %' = DIVIDE([Cirugías suspendidas], [Cirugías programadas])
		formatString: 0.0%
		displayFolder: 2. Pabellones
		lineageTag: 173cf777-17e0-5a2c-aba1-9ce454de6859

	/// Primeras cirugías del día que parten a la hora programada: si la primera parte tarde, toda la tabla se corre.
	measure 'Primera cirugía a la hora %' = DIVIDE(SUM(pabellones[primeras_a_la_hora]), SUM(pabellones[primeras_del_dia]))
		formatString: 0.0%
		displayFolder: 2. Pabellones
		lineageTag: 6b0b4302-3648-557e-9140-60663b5d5af7

	column fecha
		dataType: dateTime
		isHidden
		formatString: Short Date
