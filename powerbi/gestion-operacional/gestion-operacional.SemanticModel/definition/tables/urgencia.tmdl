		summarizeBy: none
		sourceColumn: atenciones

		annotation SummarizationSetBy = Automatic

	column atenciones_en_meta
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: de73f874-ab6b-5d76-bafd-ec3c9d2531fd
