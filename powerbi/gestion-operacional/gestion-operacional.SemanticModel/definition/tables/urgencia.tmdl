/// Urgencia por clínica, categoría de triage (C1 a C5) y mes: atenciones, espera, abandonos y espera de cama.
table urgencia
	lineageTag: ac7a4a2d-ebbb-5e93-a52e-16944440fa13

	/// Pacientes atendidos en urgencia.
	measure 'Atenciones de urgencia' = SUM(urgencia[atenciones])
		formatString: #,##0
		displayFolder: 3. Urgencia
		lineageTag: f3cf83ce-abf9-5232-a018-9e7570bda14b

	/// Atenciones cuya espera hasta el médico quedó dentro de la meta de su categoría.
	measure 'Atenciones en meta de espera %' = DIVIDE(SUM(urgencia[atenciones_en_meta]), [Atenciones de urgencia])
		formatString: 0.0%
		displayFolder: 3. Urgencia
		lineageTag: 1dcc7d0a-0865-5317-ba0a-5533648d6782

	/// Minutos promedio desde la llegada hasta la atención médica.
	measure 'Espera hasta la atención (min)' = DIVIDE(SUM(urgencia[minutos_espera]), [Atenciones de urgencia])
		formatString: #,##0
		displayFolder: 3. Urgencia
		lineageTag: b2afff8d-5c13-5ecc-adb7-83b1f4e654fa

	/// Espera máxima de la categoría de triage.
	measure 'Meta de espera (min)' = MAX(urgencia[meta_minutos])
		formatString: #,##0
		displayFolder: 3. Urgencia
		lineageTag: f44dea7e-d37e-59d6-9e86-047737aa2d6c

	/// Pacientes que se van sin ser atendidos.
	measure 'Abandono de urgencia %' = DIVIDE(SUM(urgencia[abandonos]), [Atenciones de urgencia])
		formatString: 0.0%
		displayFolder: 3. Urgencia
		lineageTag: 33928fff-437d-5e91-b034-260187964c3a

	/// Atenciones que terminan en hospitalización.
	measure 'Hospitalización desde urgencia %' = DIVIDE(SUM(urgencia[hospitalizados]), [Atenciones de urgencia])
		formatString: 0.0%
		displayFolder: 3. Urgencia
		lineageTag: 7d41398a-3241-54bd-83bf-211def573d31

	/// Horas que un paciente con indicación de hospitalización espera cama en urgencia.
	measure 'Espera de cama promedio (h)' = DIVIDE(SUM(urgencia[horas_espera_cama]), SUM(urgencia[hospitalizados]))
		formatString: 0.0
		displayFolder: 3. Urgencia
		lineageTag: a193195a-acf9-5f61-a4b0-bc791b06f89c

	column fecha
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: 3c614661-4496-5ace-8ecc-89dff9ce42f9
		summarizeBy: none
		sourceColumn: fecha

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column anio
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 48838bce-a594-5750-b3f1-53538159af9e
		summarizeBy: none
		sourceColumn: anio

		annotation SummarizationSetBy = Automatic

	column mes
