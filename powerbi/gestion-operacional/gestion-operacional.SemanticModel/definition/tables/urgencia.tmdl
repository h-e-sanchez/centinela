	partition urgencia = m
		mode: import
		source =
				let
				    Origen = LeerCsv("urgencia.csv", {{"fecha", type date}, {"anio", Int64.Type}, {"mes", Int64.Type}, {"sucursal", type text}, {"categoria", type text}, {"meta_minutos", Int64.Type}, {"atenciones", Int64.Type}, {"atenciones_en_meta", Int64.Type}, {"minutos_espera", Int64.Type}, {"abandonos", Int64.Type}, {"hospitalizados", Int64.Type}, {"horas_espera_cama", type number}})
				in
				    Origen

	annotation PBI_ResultType = Table
