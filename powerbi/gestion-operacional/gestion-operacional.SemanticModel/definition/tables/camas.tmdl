		annotation SummarizationSetBy = Automatic

	column sucursal
		dataType: string
		isHidden
		lineageTag: e5a2f6e2-192f-5f9f-b39e-e7dfa5aa9154
		summarizeBy: none
		sourceColumn: sucursal

		annotation SummarizationSetBy = Automatic

	column linea
		dataType: string
		isHidden
		lineageTag: fd738651-57de-5200-bc82-500ffb4fc886
		summarizeBy: none
		sourceColumn: linea

		annotation SummarizationSetBy = Automatic

	column camas_dotadas
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 61629e4a-3c85-5339-849d-5afb05154ba5
		summarizeBy: none
		sourceColumn: camas_dotadas

		annotation SummarizationSetBy = Automatic

	column dias_cama_disponibles
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fcaa9aba-fc05-5222-9b1f-a00a8d953a32
		summarizeBy: none
		sourceColumn: dias_cama_disponibles

		annotation SummarizationSetBy = Automatic

	column dias_cama_ocupados
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0926e4b2-7141-52c1-b72f-7b7c1c9d9a88
		summarizeBy: none
		sourceColumn: dias_cama_ocupados

		annotation SummarizationSetBy = Automatic

	column egresos
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 40713765-e439-5fe2-b57d-5b55e3d5d95d
		summarizeBy: none
		sourceColumn: egresos

		annotation SummarizationSetBy = Automatic

	column dias_estada
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 96b1dbd3-474c-5a34-8745-da53a59b29f3
		summarizeBy: none
		sourceColumn: dias_estada

		annotation SummarizationSetBy = Automatic

	column dias_estada_esperados
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 79a9b45b-4b29-598e-8a7a-6026b98a09a9
		summarizeBy: none
		sourceColumn: dias_estada_esperados

		annotation SummarizationSetBy = Automatic

	column reingresos_30d
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 59f2e0a9-d115-5c35-88da-1a6f0867a4f2
		summarizeBy: none
		sourceColumn: reingresos_30d

		annotation SummarizationSetBy = Automatic

	partition camas = m
		mode: import
		source =
				let
				    Origen = LeerCsv("camas.csv", {{"fecha", type date}, {"anio", Int64.Type}, {"mes", Int64.Type}, {"sucursal", type text}, {"linea", type text}, {"camas_dotadas", Int64.Type}, {"dias_cama_disponibles", Int64.Type}, {"dias_cama_ocupados", Int64.Type}, {"egresos", Int64.Type}, {"dias_estada", Int64.Type}, {"dias_estada_esperados", Int64.Type}, {"reingresos_30d", Int64.Type}})
				in
				    Origen

	annotation PBI_ResultType = Table
