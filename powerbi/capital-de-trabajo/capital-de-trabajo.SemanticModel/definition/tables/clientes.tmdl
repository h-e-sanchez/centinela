		annotation SummarizationSetBy = Automatic

	partition clientes = m
		mode: import
		source =
				let
				    Origen = LeerCsv("clientes.csv", {{"cliente", type text}, {"industria", type text}, {"segmento", type text}, {"condicion_dias", Int64.Type}, {"limite_credito", Int64.Type}, {"perfil_pago", type text}})
				in
				    Origen

	annotation PBI_ResultType = Table
