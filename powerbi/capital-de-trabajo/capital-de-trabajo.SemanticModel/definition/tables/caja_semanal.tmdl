/// Caja semanal por empresa: real hasta el corte y 13 semanas proyectadas.
table caja_semanal
	lineageTag: 2a2c111f-2fe6-582d-bf18-e861fd25cfc4

	/// Cobros de la semana (reales o proyectados).
	measure 'Cobros en caja' = SUM(caja_semanal[cobros])
		formatString: \$ #,##0
		displayFolder: 5. Flujo de caja
		lineageTag: 5f8a45b5-d3ca-5e69-9f08-071a653a197d

	/// Pagos de la semana: proveedores, remuneraciones y gastos, inversiones y dividendos.
	measure 'Pagos en caja' = SUM(caja_semanal[pagos])
		formatString: \$ #,##0
		displayFolder: 5. Flujo de caja
		lineageTag: 6c30e415-4217-50f5-b564-8ec6dfbf882c

	/// Saldo de caja al cierre de la semana, hasta la fecha de corte.
	measure 'Saldo real' = CALCULATE(SUM(caja_semanal[saldo_final]), caja_semanal[tipo] = "Real")
		formatString: \$ #,##0
		displayFolder: 5. Flujo de caja
		lineageTag: 9130e47e-2fab-591c-875e-92e0adec2faf

	/// Saldo de caja proyectado al cierre de cada una de las 13 semanas siguientes al corte.
	measure 'Saldo proyectado' = CALCULATE(SUM(caja_semanal[saldo_final]), caja_semanal[tipo] = "Proyectado")
		formatString: \$ #,##0
		displayFolder: 5. Flujo de caja
		lineageTag: 42e49f3b-6891-5c69-b4dd-86c480a09fad

	/// Saldo de caja de la última semana real.
	measure 'Saldo al corte' =
			VAR s = CALCULATE(MAX(caja_semanal[semana]), caja_semanal[tipo] = "Real")
			RETURN CALCULATE(SUM(caja_semanal[saldo_final]), caja_semanal[semana] = s)
		formatString: \$ #,##0
		displayFolder: 5. Flujo de caja
		lineageTag: 56322108-58a3-5b83-8c30-3b871ad18211

	/// Saldo de caja proyectado al final de las 13 semanas.
	measure 'Saldo en 13 semanas' =
			VAR s = CALCULATE(MAX(caja_semanal[semana]), caja_semanal[tipo] = "Proyectado")
			RETURN CALCULATE(SUM(caja_semanal[saldo_final]), caja_semanal[semana] = s)
		formatString: \$ #,##0
		displayFolder: 5. Flujo de caja
		lineageTag: 5fe49f57-d964-533e-8d33-de0c82b9d151

	/// Cobros de las 13 semanas proyectadas.
	measure 'Cobros proyectados' = CALCULATE(SUM(caja_semanal[cobros]), caja_semanal[tipo] = "Proyectado")
		formatString: \$ #,##0
		displayFolder: 5. Flujo de caja
		lineageTag: d22610c7-d059-5401-818d-0dc82ce163c6

	/// Pagos de las 13 semanas proyectadas.
	measure 'Pagos proyectados' = CALCULATE(SUM(caja_semanal[pagos]), caja_semanal[tipo] = "Proyectado")
		formatString: \$ #,##0
		displayFolder: 5. Flujo de caja
		lineageTag: 61207cc3-6db3-5c16-a571-aedf4940961e

	/// 1 si el saldo de la semana queda bajo el saldo mínimo elegido.
	measure 'Bajo el mínimo' = IF(SUM(caja_semanal[saldo_final]) < [Saldo mínimo elegido], 1)
		formatString: 0
		isHidden
		displayFolder: 5. Flujo de caja
		lineageTag: 6e191600-4b35-5e43-9019-383cffd10fa1

	/// Semanas con saldo bajo el mínimo elegido.
	measure 'Semanas bajo el mínimo' =
			VAR minimo = [Saldo mínimo elegido]
			RETURN COUNTROWS(FILTER(VALUES(caja_semanal[semana]), CALCULATE(SUM(caja_semanal[saldo_final])) < minimo))
		formatString: #,##0
		displayFolder: 5. Flujo de caja
		lineageTag: 76be621d-4f26-5a9f-82c5-ca44aaa81bf8

	/// Qué explica la semana bajo el mínimo: una inversión o dividendo, pagos altos o cobros bajos.
	measure Causa =
			VAR promedio = CALCULATE(AVERAGE(caja_semanal[pagos]), ALLEXCEPT(caja_semanal, caja_semanal[industria]))
			RETURN
			    IF(
			        [Bajo el mínimo] = 1,
			        SWITCH(
			            TRUE(),
			            SUM(caja_semanal[inversiones_dividendos]) > 0, "Inversión o dividendo",
			            SUM(caja_semanal[pagos]) > promedio * 1.3, "Pagos altos (remuneraciones y proveedores)",
			            "Cobros bajos"
			        )
			    )
		displayFolder: 5. Flujo de caja
		lineageTag: eef16fb0-420e-5373-b21a-ceb8ca29e2dc

	column semana
		dataType: dateTime
		formatString: Short Date
		lineageTag: 723c47f6-4bdc-5fdb-a9ff-3ebdd73177df
		summarizeBy: none
		sourceColumn: semana

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column industria
		dataType: string
		isHidden
		lineageTag: 8d7b3cba-cb5f-5c0a-bd56-6cc4574a1682
		summarizeBy: none
		sourceColumn: industria

		annotation SummarizationSetBy = Automatic

	column saldo_inicial
		dataType: int64
		isHidden
		formatString: \$ #,##0
		lineageTag: 79f8b51b-12bc-5c79-8d7d-9fd8e48f0571
		summarizeBy: none
		sourceColumn: saldo_inicial

		annotation SummarizationSetBy = Automatic

	column cobros
		dataType: int64
		isHidden
		formatString: \$ #,##0
		lineageTag: 3cc11923-a992-5e4b-b830-81441b2a23a4
		summarizeBy: none
		sourceColumn: cobros

		annotation SummarizationSetBy = Automatic

	column pagos_proveedores
		dataType: int64
		isHidden
		formatString: \$ #,##0
		lineageTag: 57c1df6b-3f06-5d7d-9b81-ed73e8d2d8eb
		summarizeBy: none
		sourceColumn: pagos_proveedores

		annotation SummarizationSetBy = Automatic

	column otros_pagos
		dataType: int64
		isHidden
		formatString: \$ #,##0
		lineageTag: 72933e49-5f19-5cad-869a-3826cd9c2765
		summarizeBy: none
		sourceColumn: otros_pagos

		annotation SummarizationSetBy = Automatic

	column inversiones_dividendos
		dataType: int64
		isHidden
		formatString: \$ #,##0
		lineageTag: 8a49ab34-6251-5b53-85fc-54cebc106d31
		summarizeBy: none
		sourceColumn: inversiones_dividendos

		annotation SummarizationSetBy = Automatic

	column pagos
		dataType: int64
		isHidden
		formatString: \$ #,##0
		lineageTag: b4ce7874-f21c-5b3a-9688-84347f09a5bf
		summarizeBy: none
		sourceColumn: pagos

		annotation SummarizationSetBy = Automatic

	column saldo_final
		dataType: int64
		isHidden
		formatString: \$ #,##0
		lineageTag: 42ef8fb2-ceec-5002-acbd-d39dbceed9b3
		summarizeBy: none
		sourceColumn: saldo_final

		annotation SummarizationSetBy = Automatic

	column tipo
		dataType: string
		lineageTag: 1e597b89-1f9d-5b9f-84d0-a4b65f5c2745
		summarizeBy: none
		sourceColumn: tipo

		annotation SummarizationSetBy = Automatic

	column ventana
		dataType: string
		lineageTag: e857c54f-7a37-564f-ad2b-4b474372faff
		summarizeBy: none
		sourceColumn: ventana

		annotation SummarizationSetBy = Automatic

	partition caja_semanal = m
		mode: import
		source =
				let
				    Origen = LeerCsv("caja_semanal.csv", {{"semana", type date}, {"industria", type text}, {"saldo_inicial", Int64.Type}, {"cobros", Int64.Type}, {"pagos_proveedores", Int64.Type}, {"otros_pagos", Int64.Type}, {"inversiones_dividendos", Int64.Type}, {"pagos", Int64.Type}, {"saldo_final", Int64.Type}, {"tipo", type text}, {"ventana", type text}})
				in
				    Origen

	annotation PBI_ResultType = Table
