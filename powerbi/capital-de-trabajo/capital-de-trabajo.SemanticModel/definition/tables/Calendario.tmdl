/// Dimensión de fechas 2025-2026.
table Calendario
	lineageTag: 3d06319a-a556-54f6-8094-64e506daa382
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: bda85ad8-0371-5a88-b498-648b35494d03
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Anio
		dataType: int64
		formatString: 0
		lineageTag: 4ce2b68d-cc54-5da4-be95-ce0a65775805
		summarizeBy: none
		isNameInferred
		sourceColumn: [Anio]

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a6bc3488-03e0-5fdd-b322-5c296f0a6461
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes]

		annotation SummarizationSetBy = Automatic

	column 'Nombre Mes'
		dataType: string
		lineageTag: e9ee79ab-f018-519f-8f38-c1293e077dda
		summarizeBy: none
		isNameInferred
		sourceColumn: [Nombre Mes]
		sortByColumn: Mes

		annotation SummarizationSetBy = Automatic

	column 'Periodo Num'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 66106da9-c933-5278-bf74-60052e9162fb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Periodo Num]

		annotation SummarizationSetBy = Automatic

	column 'Mes Año'
		dataType: string
		lineageTag: e149b3a4-f76d-56ff-8b29-5880747ec611
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes Año]
		sortByColumn: 'Periodo Num'

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2025, 1, 1), DATE(2026, 12, 31)),
				    "Anio", YEAR([Date]),
				    "Mes", MONTH([Date]),
				    "Nombre Mes", FORMAT([Date], "mmm"),
				    "Periodo Num", YEAR([Date]) * 100 + MONTH([Date]),
				    "Mes Año", FORMAT([Date], "mmm yyyy")
				)

	annotation PBI_ResultType = Table
