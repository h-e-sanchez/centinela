/// Parámetro what-if: saldo mínimo de caja, de $20 M a $150 M.
table 'Saldo mínimo'
	lineageTag: 018a36fc-b5d5-5291-8c24-238da3d2edc5

	/// Saldo mínimo elegido en el segmentador; si no hay uno elegido, $60 M.
	measure 'Saldo mínimo elegido' = SELECTEDVALUE('Saldo mínimo'[Saldo mínimo], 60000000)
		formatString: \$ #,##0
		displayFolder: 5. Flujo de caja
		lineageTag: 9af9be6e-1abf-5553-a802-f42f4f541622

	column 'Saldo mínimo'
		dataType: int64
		formatString: \$ #,##0
		lineageTag: 5661cc9e-b1fe-5ae2-8479-6b5f1464252b
		summarizeBy: none
		sourceColumn: [Value]

		extendedProperty ParameterMetadata =
				{
				  "version": 0
				}

		annotation SummarizationSetBy = User

	partition 'Saldo mínimo' = calculated
		mode: import
		source = GENERATESERIES(20000000, 150000000, 10000000)

	annotation PBI_ResultType = Table
