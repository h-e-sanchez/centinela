		annotation SummarizationSetBy = Automatic

	partition presupuesto_ingresos = m
		mode: import
		source =
				let
				    Origen = LeerCsv("presupuesto_ingresos.csv", {{"fecha", type date}, {"anio", Int64.Type}, {"industria", type text}, {"sucursal", type text}, {"cuenta", type text}, {"monto", Int64.Type}})
				in
				    Origen

	annotation PBI_ResultType = Table
