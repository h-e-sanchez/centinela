	partition transacciones = m
		mode: import
		source =
				let
				    Origen = LeerCsv("transacciones.csv", {{"id_linea", type text}, {"fecha", type date}, {"anio", Int64.Type}, {"industria", type text}, {"sucursal", type text}, {"cuenta", type text}, {"canal", type text}, {"cliente", type text}, {"producto", type text}, {"cantidad", type number}, {"ingreso_lista", Int64.Type}, {"descuento_comercial", Int64.Type}, {"rappel", Int64.Type}, {"bonificacion", Int64.Type}, {"ingreso_neto", Int64.Type}, {"costo_variable", Int64.Type}, {"costo_servir", Int64.Type}})
				in
				    Origen

	annotation PBI_ResultType = Table
