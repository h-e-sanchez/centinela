/// Dimensión: las nueve sucursales, las mismas del reporte Presupuesto vs. Real.
table sucursales
	lineageTag: 0e2fd694-05e6-55e6-a725-9b2e5d32a0be

	column sucursal
		dataType: string
		lineageTag: 18f4a4f0-d820-504e-8b65-b56cd3faa8b2
		summarizeBy: none
		sourceColumn: sucursal
		sortByColumn: orden

		annotation SummarizationSetBy = Automatic

	column industria
		dataType: string
		isHidden
		lineageTag: 0b4c7b23-a8f7-5d6f-99c5-4842ad719f7e
		summarizeBy: none
